{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build_for_ARM",
      "command": "/usr/bin/arm-linux-gnueabihf-g++",
      "args": [
        "-std=c++26",
        "-static",
        "-Wall",
        "-Wno-nonnull",
        "-I/usr/local/boost_1_92_0_arm",
        "-I${workspaceFolder}",
        "-I${workspaceFolder}/../LIB.Share",
        "-I${workspaceFolder}/../LIB.Utils",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/dev/config.cpp",
        "${workspaceFolder}/dev/connection.cpp",
        "${workspaceFolder}/../LIB.Share/shareConfig.cpp",
        "${workspaceFolder}/../LIB.Share/shareLog.cpp",
        "${workspaceFolder}/../LIB.Share/shareMQTT.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsChrono.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsException.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsLinux.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsLog.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsPacketMQTTv3_1_1.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsPath.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsTime.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsVersion.cpp",
        "-o",
        "${workspaceFolder}/mxmqtt"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Build_for_PC",
      "command": "/usr/bin/g++-14",
      "args": [
        "-fdiagnostics-color=always",
        "-std=c++26",
        "-g",
        "-Wall",
        "-Wno-nonnull",
        "-I/usr/local/boost_1_92_0",
        "-I${workspaceFolder}",
        "-I${workspaceFolder}/../LIB.Utils",
        "-I${workspaceFolder}/../LIB.Share",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/dev/config.cpp",
        "${workspaceFolder}/dev/connection.cpp",
        "${workspaceFolder}/../LIB.Share/shareConfig.cpp",
        "${workspaceFolder}/../LIB.Share/shareLog.cpp",
        "${workspaceFolder}/../LIB.Share/shareMQTT.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsChrono.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsException.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsLinux.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsLog.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsPacketMQTTv3_1_1.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsPath.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsTime.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsVersion.cpp",
        "-o",
        "${workspaceFolder}/mxmqtt_dbg"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "compiler: /usr/bin/g++"
    }
  ]
}