{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build_for_ARM",
      "command": "/usr/bin/arm-linux-gnueabihf-g++",
      "args": [
        "-std=c++26",
        "-static",
        "-Wall",
        "-I/usr/local/boost_1_92_0_arm",
        "-L/usr/arm-linux-gnueabihf/lib",
        "-I${workspaceFolder}",
        "-I${workspaceFolder}/../LIB.Utils",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/dev/rtc.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsException.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsLinux.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsLog.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsPath.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsString.cpp",
        "-o",
        "${workspaceFolder}/mxsystem"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Build_for_PC",
      "command": "/usr/bin/g++",
      "args": [
        "-fdiagnostics-color=always",
        "-std=c++26",
        "-g",
        "-Wall",
        "-I/usr/local/boost_1_92_0",
        "-L/usr/arm-linux-gnueabihf/lib",
        "-I${workspaceFolder}",
        "-I${workspaceFolder}/../LIB.Utils",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/dev/rtc.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsException.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsLinux.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsLog.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsPath.cpp",
        "${workspaceFolder}/../LIB.Utils/utilsString.cpp",
        "-o",
        "${workspaceFolder}/mxsystem_dbg"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "detail": "compiler: /usr/bin/g++"
    }
  ]
}